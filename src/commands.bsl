// Модуль для выполнения наиболее популярных наборов команд

Функция ИсполнитьКоманду(Знач СтрокаВыполнения, Лог = Неопределено) Экспорт

	Команда = Новый Команда;
	Команда.ПоказыватьВыводНемедленно(Истина);
	Команда.УстановитьПравильныйКодВозврата(0);

	Если Лог <> Неопределено Тогда
		Лог.Информация(СтрокаВыполнения);
	КонецЕсли;

	Команда.УстановитьСтрокуЗапуска(СтрокаВыполнения);
	Команда.Исполнить();

КонецФункции
